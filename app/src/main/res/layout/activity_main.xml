<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Status bar -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#1B8A3C"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@string/status_idle"/>

        <Button
            android:id="@+id/btnStop"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/btn_stop"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#CC0000"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Mode selector tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="#F0F0F0"
        android:padding="6dp"
        android:weightSum="2">

        <Button
            android:id="@+id/btnModePoint"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📍 Точка"
            android:textSize="13sp"
            android:backgroundTint="#1B8A3C"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnModeRoute"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="🛣 Маршрут"
            android:textSize="13sp"
            android:backgroundTint="#BDBDBD"
            android:textColor="#444444"/>
    </LinearLayout>

    <!-- Map — takes all remaining space -->
    <WebView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- ═══════════════════════════════════════════
         POINT MODE PANEL
         ═══════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/panelPoint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <!-- City preset shortcuts -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:scrollbars="none"
            android:background="#F8F8F8">
            <LinearLayout
                android:id="@+id/presetsContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
        </HorizontalScrollView>

        <!-- Bearing control: label + value on one line, slider below -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Поворот камеры"
                    android:textSize="13sp"
                    android:textColor="#555555"/>

                <TextView
                    android:id="@+id/tvBearing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0°"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1B8A3C"
                    android:minWidth="44dp"
                    android:gravity="end"/>
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekBearing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="359"
                android:progress="0"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ═══════════════════════════════════════════
         ROUTE MODE PANEL
         ═══════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/panelRoute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:visibility="gone">

        <!-- Speed / time selector row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <Button
                    android:id="@+id/btnSpeedMode"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="По скорости"
                    android:textSize="11sp"
                    android:backgroundTint="#1B8A3C"
                    android:textColor="#FFFFFF"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/tvSpeedTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60 км/ч"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1B8A3C"
                    android:minWidth="70dp"
                    android:gravity="end"/>
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekSpeedTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="199"
                android:progress="59"/>
        </LinearLayout>

        <!-- Primary playback controls: two big buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="4dp"
            android:weightSum="2">

            <!-- Play / Pause share the same slot -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp">

                <Button
                    android:id="@+id/btnRoutePlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="▶  Старт"
                    android:textSize="14sp"
                    android:backgroundTint="#1B8A3C"
                    android:textColor="#FFFFFF"/>

                <Button
                    android:id="@+id/btnRoutePause"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="⏸  Пауза"
                    android:textSize="14sp"
                    android:backgroundTint="#FF8C00"
                    android:textColor="#FFFFFF"
                    android:visibility="gone"/>
            </FrameLayout>

            <Button
                android:id="@+id/btnRouteStop"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="⏹  Стоп"
                android:textSize="14sp"
                android:backgroundTint="#CC0000"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- Secondary: info, loop, clear -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/tvRouteInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0 точек"
                android:textSize="12sp"
                android:textColor="#777777"/>

            <Button
                android:id="@+id/btnRouteLoop"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🔁 Петля"
                android:textSize="12sp"
                android:backgroundTint="#BDBDBD"
                android:textColor="#444444"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>

            <Button
                android:id="@+id/btnRouteClear"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🗑 Очистить"
                android:textSize="12sp"
                android:backgroundTint="#757575"
                android:textColor="#FFFFFF"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
